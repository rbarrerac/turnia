# Plantilla de variables de entorno de Turnia (documentación general).
# El archivo que realmente usan las herramientas (dotenv, Prisma) es api/.env.example:
# cópialo a api/.env antes de ejecutar el backend. Ver README.md / INSTALACION.md.

# Base de datos
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/turnia"

# Autenticación
JWT_SECRET="cadena-larga-aleatoria-cambiar-en-produccion"
JWT_EXPIRACION="7d"

# Servidor de correo (SMTP)
SMTP_HOST="smtp.ejemplo.com"
SMTP_PUERTO="587"
SMTP_USUARIO="tu-correo@ejemplo.com"
SMTP_CONTRASENA="clave-de-aplicacion"
SMTP_REMITENTE="Turnia <no-responder@turnia.gt>"

# Servidor
PUERTO_API="4000"
ORIGEN_PERMITIDO="http://localhost:5173"
