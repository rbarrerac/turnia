# Plantilla de variables de entorno de Turnia (documentación general).
# El archivo que realmente usan las herramientas (dotenv, Prisma) es api/.env.example:
# cópialo a api/.env antes de ejecutar el backend. Ver README.md / INSTALACION.md.

# Base de datos — rol dedicado de la aplicación (no el superusuario de Postgres)
DATABASE_URL="postgresql://turnia_app:cambia-esta-clave-app@localhost:5432/turnia"

# Superusuario de PostgreSQL — solo lo usan los scripts de preparación de la base
# de datos (npm run preparar-bd / reiniciar-bd) para crear el rol, la base y la
# extensión btree_gist. Nunca se usa para las conexiones normales de la API.
PG_SUPERUSUARIO="postgres"
PG_SUPERCLAVE="cambia-esta-clave-superusuario"
PG_HOST="localhost"
PG_PUERTO="5432"

# Autenticación
JWT_SECRET="cadena-larga-aleatoria-cambiar-en-produccion"
JWT_EXPIRACION="7d"

# Servidor de correo (SMTP)
SMTP_HOST="smtp.ejemplo.com"
SMTP_PUERTO="587"
SMTP_USUARIO="tu-correo@ejemplo.com"
SMTP_CONTRASENA="clave-de-aplicacion"
SMTP_REMITENTE="Turnia <no-responder@turnia.gt>"

# Servidor
PUERTO_API="4000"
ORIGEN_PERMITIDO="http://localhost:5173"

# Semilla (usada solo por prisma/semilla.js)
# Administradora sembrada; si se omiten se usan los valores por defecto indicados
# y se imprime una advertencia. Definirlas siempre en producción.
CORREO_ADMIN="admin@turnia.gt"
CONTRASENA_ADMIN="cambia-esta-clave"
# Clienta de prueba sembrada; mismo comportamiento por defecto que la administradora.
CORREO_CLIENTA="clienta@turnia.gt"
CONTRASENA_CLIENTA="cambia-esta-clave"
