# Plantilla de variables de entorno para pruebas automáticas (Jest + Supertest).
# Copia este archivo a api/.env.prueba y apunta a una base de datos DESECHABLE,
# distinta de la de desarrollo (las pruebas crean y limpian datos en cada corrida).

DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/turnia_prueba"

JWT_SECRET="secreto-de-pruebas"
JWT_EXPIRACION="1h"

PUERTO_API="4001"
ORIGEN_PERMITIDO="http://localhost:5173"
